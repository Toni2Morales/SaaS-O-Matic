# Normalización de finales de línea.
# El repositorio almacena LF; Windows conserva CRLF solo donde es necesario.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: sin conversión ni diffs de texto.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.xlsx binary
*.sqlite binary
*.sqlite3 binary
*.db binary

# Lockfiles: tratados como generados para reducir ruido en revisiones.
package-lock.json linguist-generated=true
