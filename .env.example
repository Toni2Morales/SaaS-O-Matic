# Plantilla de configuración local (PROVISIONAL).
# Los nombres y valores siguientes son una propuesta de partida: todavía no
# existe código que los consuma. Se alinearán con la configuración real al
# crear el scaffold del backend.
# Copia este fichero como .env y ajusta los valores.
# Nunca incluyas credenciales, tokens ni secretos reales en el repositorio.

# --- Aplicación ---
APP_ENV=local
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Base de datos ---
# SQLite local. La ruta por defecto se resolverá al implementar el backend.
DATABASE_URL=sqlite:///./data/saas_o_matic.db

# --- API ---
# Origen del frontend en desarrollo (Angular).
CORS_ORIGINS=http://localhost:4200

# --- Divisas ---
# Proveedor público de tipos de cambio: pendiente de selección y validación.
EXCHANGE_RATE_API_URL=
# Solo si el proveedor elegido requiere clave.
EXCHANGE_RATE_API_KEY=

# --- Fiscalidad ---
# Fuente autoritativa de tipos impositivos: pendiente de confirmar con el propietario.
TAX_RULES_SOURCE=
